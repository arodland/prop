[Unit]
Description=Daily solar/geomagnetic indices (GFZ, SILSO) into Postgres
BindsTo=prop-postgres.service
After=prop-postgres.service
PartOf=kc2gprop.target
[Service]
Type=oneshot
Delegate=yes
ExecStartPre=/usr/bin/rm -f %t/%N-pid %t/%N-cid
ExecStart=/usr/bin/podman run --rm --replace --pod=prop --name %N --conmon-pidfile /%t/%N-pid --cidfile /%t/%N-cid --cgroups=no-conmon --attach stdin --log-driver journald --user 1001 --env-file /etc/kc2gprop/db.env prop-forecast /app/.venv/bin/python /app/service/indices.py
TimeoutStartSec=600
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/%N-cid -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/%N-cid
[Install]
WantedBy=kc2gprop.target
